# Copy to .env and fill in. NEVER commit .env. Values marked REQUIRED have no safe default.

CBI_ENVIRONMENT=development            # development | test | staging | production

# --- Database (docker compose) ------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=change-me  # REQUIRED; only used to bootstrap roles
CBI_DB_OWNER_PASSWORD=change-me        # REQUIRED; migrations + backups role
CBI_DB_APP_PASSWORD=change-me          # REQUIRED; runtime role (RLS enforced)
CBI_DATABASE_URL=postgresql+psycopg://copperbelt_app:change-me@db:5432/copperbelt
CBI_DATABASE_OWNER_URL=postgresql+psycopg://copperbelt:change-me@db:5432/copperbelt

# --- Auth ----------------------------------------------------------------------
CBI_JWT_SECRET=                        # REQUIRED outside development: >= 32 random chars (openssl rand -hex 32)
CBI_ACCESS_TOKEN_MINUTES=30
CBI_REFRESH_TOKEN_DAYS=14
CBI_CORS_ORIGINS=["http://localhost:3000"]

# --- Object storage ------------------------------------------------------------
CBI_STORAGE_BACKEND=local              # local | s3
CBI_STORAGE_LOCAL_ROOT=/data/objects
# CBI_S3_BUCKET=
# CBI_S3_ENDPOINT_URL=                 # for MinIO / R2
# CBI_S3_REGION=

# --- Uploads & malware scanning ---------------------------------------------------
CBI_MAX_UPLOAD_BYTES=209715200
CBI_CLAMAV_HOST=                       # set to the clamd host; compose sets 'clamav'
CBI_REQUIRE_MALWARE_SCAN=false         # set true in staging/production

# --- OCR --------------------------------------------------------------------------
CBI_OCR_LANGUAGES=eng+fra

# --- External providers (leave empty = reported as 'unconfigured') ---------------------
CBI_PLANET_API_KEY=
CBI_PLANET_MONTHLY_BUDGET_USD=          # orders are refused until a budget is set
CBI_PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_3
CBI_LLM_PROVIDER=none                  # none | openai | anthropic
CBI_LLM_API_KEY=
CBI_LLM_MODEL=
CBI_EMBEDDING_PROVIDER=none
CBI_EMBEDDING_API_KEY=
CBI_EMBEDDING_MODEL=

# --- Migrations ---------------------------------------------------------------------
# CBI_APP_DB_ROLE=copperbelt_app       # runtime role granted access by migrations; change only if bootstrap.sql used another name

# --- Web app (build-time, baked into the Next.js bundle) -------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_MAP_STYLE_URL=           # basemap style JSON; default is the MapLibre demo tiles

# --- Backend test suite (backend/tests/conftest.py) ----------------------------------
# Not read by the running app. Defaults match the CI setup in .github/workflows/ci.yml.
# CBI_TEST_DB=copperbelt_test          # database the tests drop and recreate; never point at real data
# CBI_TEST_DB_HOST=localhost
# CBI_TEST_APP_PASSWORD=devpassword    # password of copperbelt_app in the test cluster
# CBI_TEST_OWNER_PASSWORD=devpassword  # password of copperbelt in the test cluster
# CBI_RUN_LIVE=                        # set to 1 to run tests that call real providers (needs real keys)

# --- Scripts against a running stack (backend/scripts/) ------------------------------
# CBI_SMOKE_URL=http://localhost:8000  # API base URL for smoke.py and ingest_eval.py
# CBI_EVAL_EMAIL=evaluation@example.com   # account ingest_eval.py creates or reuses
# CBI_EVAL_PASSWORD=                   # its password; pick a strong one

# --- Browser journey test (frontend/e2e/journey.mjs) ---------------------------------
# WEB=http://localhost:3000            # web app under test
# FIXTURE=                             # path to a SYNTHETIC PDF to upload (never a real customer document)
# CHROME=                              # Chrome/Chromium binary; if empty, @sparticuz/chromium is used
# SHOTS=e2e-shots                      # screenshot output directory
